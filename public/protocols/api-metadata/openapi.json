      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 9457 product errors only, application/problem+json and Cache-Control no-store. instance is an opaque occurrence identifier, never the request URL. Clients preserve unknown extensions and branch on code/type; protocol-native errors are separate.",
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Safe domain metadata, such as affected feature keys or counts. Field violations also appear in errors with a JSON Pointer.",
            "type": "object"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "pattern": "^urn:assign:problem:[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "reason": {
            "description": "Domain-specific refusal discriminator. code and type identify the canonical error category; reason preserves the precise domain cause.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "format": "uri",
            "pattern": "^https://docs\\.assign\\.so/errors/[a-z][a-z0-9_]*$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id",
          "retryable"
        ],
        "type": "object"
