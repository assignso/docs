{
  "components": {
    "headers": {
      "AssignAPIVersion": {
        "description": "Assign-API-Version diagnostic, never authorization or an old-contract selector.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "AssignDeadlineMs": {
        "description": "Remaining request time budget at admission in milliseconds, capped by any earlier deadline already applied to the request. The value is diagnostic; client-supplied values do not extend work. Cancellation is cooperative and bounds work that observes it. A timeout or disconnect does not prove that a committed mutation rolled back; recover using the operation's retained idempotency key/receipt before issuing another mutation. Committed responses are preserved.",
        "schema": {
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      },
      "AssignLimit": {
        "description": "Assign application limit metadata version 1, independent of draft IETF RateLimit fields. The closed kind/scope/policy/unit labels identify the applicable existing budget, never a bucket, credential, actor identifier or private queue depth. The search class is query cost (one admitted query unit), not paid entitlement. cost is the units required by this request; limit/remaining are window units when known; reset is Unix seconds. Concurrent and entitlement outcomes omit unknown counters. A reset or Retry-After is earliest retry guidance, not guaranteed admission. Honor Retry-After within the caller deadline, use bounded backoff with jitter and do not loop automatically on quota/entitlement failures.",
        "schema": {
          "maxLength": 256,
          "pattern": "^version=1; kind=(rate|cost|quota|concurrency|entitlement|overload|availability); scope=(principal|peer|upstream|workspace|session|service); policy=[a-z]+(?:[._][a-z]+)*; unit=(request|query|byte|connection|credit)(?:; cost=[1-9][0-9]*)?(?:; limit=[1-9][0-9]*; remaining=[0-9]+)?(?:; reset=[0-9]+)?$",
          "type": "string"
        }
      },
      "AssignRequestID": {
        "description": "Assign-Request-ID on every response; X-Request-ID is its correlation alias.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "AssignServerVersion": {
        "description": "Assign-Server-Version diagnostic, independent artifact version.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "Prevents storage of error responses by clients and intermediaries.",
        "schema": {
          "const": "no-store",
          "type": "string"
        }
      },
      "ContentTypeOptions": {
        "description": "Prevents user agents from MIME-sniffing the response.",
        "schema": {
          "const": "nosniff",
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Retry-After delay-seconds or HTTP-date; honor within the caller deadline.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "WWWAuthenticate": {
        "description": "Applicable bearer challenge on product authentication failures.",
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "responses": {
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request is forbidden.",
        "headers": {
          "Assign-API-Version": {
            "$ref": "#/components/headers/AssignAPIVersion"
          },
          "Assign-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          },
          "Assign-Server-Version": {
            "$ref": "#/components/headers/AssignServerVersion"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptions"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          }
        }
      },
      "ProductProblem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/MalformedRequestProblem"
                },
                {
                  "$ref": "#/components/schemas/UnauthenticatedProblem"
                },
                {
                  "$ref": "#/components/schemas/PaymentRequiredProblem"
                },
                {
                  "$ref": "#/components/schemas/ForbiddenProblem"
                },
                {
                  "$ref": "#/components/schemas/NotFoundProblem"
                },
                {
                  "$ref": "#/components/schemas/MethodNotAllowedProblem"
                },
                {
                  "$ref": "#/components/schemas/NotAcceptableProblem"
                },
                {
                  "$ref": "#/components/schemas/ConflictProblem"
                },
                {
                  "$ref": "#/components/schemas/IdempotencyKeyConflictProblem"
                },
                {
                  "$ref": "#/components/schemas/OperationInProgressProblem"
                },
                {
                  "$ref": "#/components/schemas/GoneProblem"
                },
                {
                  "$ref": "#/components/schemas/PreconditionFailedProblem"
                },
                {
                  "$ref": "#/components/schemas/ContentTooLargeProblem"
                },
                {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeProblem"
                },
                {
                  "$ref": "#/components/schemas/ValidationFailedProblem"
                },
                {
                  "$ref": "#/components/schemas/LockedProblem"
                },
                {
                  "$ref": "#/components/schemas/PreconditionRequiredProblem"
                },
                {
                  "$ref": "#/components/schemas/RateLimitedProblem"
                },
                {
                  "$ref": "#/components/schemas/InternalErrorProblem"
                },
                {
                  "$ref": "#/components/schemas/NotImplementedProblem"
                },
                {
                  "$ref": "#/components/schemas/BadGatewayProblem"
                },
                {
                  "$ref": "#/components/schemas/ServiceUnavailableProblem"
                },
                {
                  "$ref": "#/components/schemas/GatewayTimeoutProblem"
                }
              ]
            }
          }
        },
        "description": "An HTTP admission, validation, domain or availability failure. The status and code select a catalog entry. Errors use no-store; 401 includes WWW-Authenticate, 405 includes Allow, and 429/503 include Retry-After. Stream errors use this response only before the stream is committed.",
        "headers": {
          "Allow": {
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          "Assign-API-Version": {
            "$ref": "#/components/headers/AssignAPIVersion"
          },
          "Assign-Deadline-Ms": {
            "$ref": "#/components/headers/AssignDeadlineMs"
          },
          "Assign-Limit": {
            "$ref": "#/components/headers/AssignLimit"
          },
          "Assign-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          },
          "Assign-Server-Version": {
            "$ref": "#/components/headers/AssignServerVersion"
          },
          "Cache-Control": {
            "schema": {
              "enum": [
                "no-store"
              ],
              "type": "string"
            }
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWWAuthenticate"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          }
        }
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The caller has exceeded an applicable abuse-control limit.",
        "headers": {
          "Assign-API-Version": {
            "$ref": "#/components/headers/AssignAPIVersion"
          },
          "Assign-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          },
          "Assign-Server-Version": {
            "$ref": "#/components/headers/AssignServerVersion"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "Retry-After": {
            "description": "Seconds until the client may retry.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/ContentTypeOptions"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/AssignRequestID"
          }
        }
      }
    },
