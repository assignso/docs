  "info": {
    "description": "Anonymous nonpersonalized API identity and advisory capability discovery. This document does not grant authority or promise released client compatibility.",
    "license": {
      "identifier": "LicenseRef-Proprietary",
      "name": "Proprietary"
    },
    "title": "Assign API metadata discovery protocol",
    "version": "1.0.0-rc.10"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/meta": {
      "get": {
        "description": "Returns build-backed API identity and advisory client support without requiring credentials. Client headers do not change this response or authorize other operations. An empty supported_clients list makes no client-version compatibility promise. Always fetch the current document; conditional request headers do not select a cached response.",
        "operationId": "getApiMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "api_major": {
                      "const": 1,
                      "type": "integer"
                    },
                    "capabilities": {
                      "items": {
                        "pattern": "^[a-z][a-z0-9._-]{0,63}$",
                        "type": "string"
                      },
                      "maxItems": 64,
                      "type": "array",
                      "uniqueItems": true
                    },
                    "contract_epoch": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "minimum_version_enforcement": {
                      "const": "none",
                      "type": "string"
                    },
                    "schema_epoch": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "server_version": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string"
                    },
                    "supported_clients": {
                      "items": {
                        "properties": {
                          "client": {
                            "pattern": "^[a-z][a-z0-9._-]{0,63}$",
                            "type": "string"
                          },
                          "maximum_version": {
                            "maxLength": 64,
                            "minLength": 5,
                            "type": "string"
                          },
